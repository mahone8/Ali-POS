// Prisma schema for the Ali POS System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Admin / staff accounts. Currently only a single role is used ("admin").
// Storing users in the DB lets you add more later without code changes.
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  passwordSalt String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Article {
  id        String   @id @default(cuid())
  sku       String   @unique // acts as the barcode / scan code
  name      String
  category  String   // e.g. Shirt, Jeans, Jacket, T-Shirt, Dress
  brand     String?
  size      String   // e.g. S, M, L, XL, 32, 34
  color     String?
  price     Float    // selling price
  cost      Float    // cost price (for profit calc)
  stock     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     SaleItem[]

  @@index([category])
  @@index([name])
}

model Sale {
  id            String   @id @default(cuid())
  receiptNo     String   @unique // e.g. RCP-20260920-0001
  customerName  String?  // optional walk-in customer
  customerPhone String?
  subtotal      Float
  taxRate       Float    @default(0) // stored as fraction (0.05 = 5%)
  taxAmount     Float    @default(0)
  discount      Float    @default(0) // absolute amount
  total         Float
  paymentMethod String   @default("Cash") // Cash | Card | Wallet
  paidAmount    Float    @default(0)
  changeAmount  Float    @default(0)
  createdAt     DateTime @default(now())

  items         SaleItem[]

  @@index([createdAt])
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  articleId   String?
  sku         String
  name        String
  category    String
  size        String
  color       String?
  price       Float // unit price at time of sale
  quantity    Int
  subtotal    Float

  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  article     Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)

  @@index([saleId])
}
